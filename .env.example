# Tuya IoT Platform credentials
# Get these from https://iot.tuya.com -> Cloud -> your project -> Overview
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_SECRET=your_access_secret_here

# API endpoint for your region:
#   US  -> https://openapi.tuyaus.com
#   EU  -> https://openapi.tuyaeu.com
#   CN  -> https://openapi.tuyacn.com
#   IN  -> https://openapi.tuyain.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# Comma-separated device IDs for your 4 water sensors.
# Find them in Tuya IoT: Cloud -> your project -> Devices tab.
# Optionally add a friendly name after a colon: id:Name
DEVICE_IDS=device_id_1:Tank A,device_id_2:Tank B,device_id_3:Tank C,device_id_4:Tank D

# The DPS (Data Point Status) code that holds the water level value.
# Common values: "water_level_percent", "va_humidity", "water_level_state"
# Leave blank to auto-detect (the app will log all available codes on first run).
WATER_LEVEL_CODE=

# How often to poll Tuya (seconds). Default: 300 (5 minutes)
POLL_INTERVAL=300

# Flask
FLASK_PORT=5000
